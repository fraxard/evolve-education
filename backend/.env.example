# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
DATABASE_URL=postgresql://username:password@localhost:5432/evolve_education_dev
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=evolve_education_dev

# Session Authentication
SESSION_SECRET=your_secure_random_session_secret_change_in_production
SESSION_NAME=evolve_sid

# Client Origin & Subdomain Cookies
CLIENT_ORIGIN=http://localhost:5173
# COOKIE_DOMAIN=.yourdomain.com  # Set in production to share session across subdomains (e.g. admin.yourdomain.com)

# Initial Admin Bootstrap (Used only by npm run admin:bootstrap)
ADMIN_EMAIL=admin@evolve.edu
ADMIN_PASSWORD=your_secure_admin_bootstrap_password
ADMIN_FULL_NAME=System Administrator
